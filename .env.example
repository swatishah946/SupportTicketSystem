# Copy to .env and fill in. Never commit the real .env.

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
# Comma-separated. Include your public hostname in production.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Only needed when the frontend is served from a different origin than the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost
# Set to True when the site is served over HTTPS (secure cookies, HSTS, redirects).
HTTPS=False

# --- Database (docker compose builds DATABASE_URL from these) --------------
POSTGRES_DB=nexusdesk
POSTGRES_USER=nexusdesk
POSTGRES_PASSWORD=change-me-too

# --- AI (optional: without a key the app uses rule-based triage + lexical retrieval)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Google sign-in (optional) ----------------------------------------------
# OAuth "Web application" Client ID from Google Cloud Console. Only the ID is
# needed (no client secret), and it is public by design. This one is authorised
# for http://localhost and http://localhost:5173; add your deployed address in
# Google Cloud Console (Clients > Authorized JavaScript origins) before using it there.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=306876022491-145h5rsuk4aqigfon6lkak04ithc7dic.apps.googleusercontent.com

# --- Tuning (defaults shown) -------------------------------------------------
# THROTTLE_AI=20/min
# AUTO_ASSIGN_TICKETS=True
# DUPLICATE_THRESHOLD_LEXICAL=0.30
# DUPLICATE_THRESHOLD_HYBRID=0.70
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
